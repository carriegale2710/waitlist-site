# Copy this file to .env and fill in every value, then run: node build.js
# These values appear in the public site, so don't put secrets here.
# Put quotes around any value that contains an apostrophe or a #.

# Tally form IDs. A form at https://tally.so/r/wAbCd1 has the ID wAbCd1.
TALLY_WAITLIST_FORM_ID=
TALLY_CONTACT_FORM_ID=

# Google Analytics 4 Measurement ID, such as G-XXXXXXXXXX.
GA_MEASUREMENT_ID=

# Public contact email, such as hello@example.com.
CONTACT_EMAIL=

# Name shown in the header, footer and page titles, such as example.com.
BRAND_NAME=

# Name in the footer copyright line, such as Example Company.
COMPANY_NAME=

# Location in the footer's "Built in ..." line, such as Sydney, Australia.
LOCATION=

# Home page heading and page title, such as Beauty for Every Body.
SITE_TAGLINE=

# Home page description for search results, one or two sentences.
SITE_DESCRIPTION=
